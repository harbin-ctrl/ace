#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
fs_uae=${FS_UAE:-fs-uae}
af_root=${AF_ROOT:-/home/pi/AF/Shared}
model=${AMIGA_MODEL:-A1200}
rom=${AMIGA_ROM:-$af_root/rom/amiga-os-310-a1200.rom}

if ! command -v "$fs_uae" >/dev/null 2>&1; then
    printf '%s\n' "FS-UAE not found: $fs_uae" >&2
    exit 2
fi
if [ ! -f "$rom" ]; then
    printf '%s\n' "Amiga ROM not found: $rom" >&2
    exit 2
fi
if [ ! -d "$af_root/dir/System" ]; then
    printf '%s\n' "Amiga Forever System directory not found: $af_root/dir/System" >&2
    exit 2
fi

run_root=$(mktemp -d "${TMPDIR:-/tmp}/ace-amiga-ed.XXXXXX")
system_root=$run_root/System
work_root=$run_root/Work
log_file=$run_root/fs-uae.log
config_file=$run_root/amiga-ed-test.fs-uae
probe_root=$work_root/ed-probe
emulator_pid=

stop_emulator()
{
    if [ -n "$emulator_pid" ] && kill -0 "$emulator_pid" 2>/dev/null; then
        kill -TERM "$emulator_pid" 2>/dev/null || true
        ticks=0
        while kill -0 "$emulator_pid" 2>/dev/null && [ "$ticks" -lt 20 ]; do
            sleep 0.1
            ticks=$((ticks + 1))
        done
        if kill -0 "$emulator_pid" 2>/dev/null; then
            kill -KILL "$emulator_pid" 2>/dev/null || true
        fi
        wait "$emulator_pid" 2>/dev/null || true
    fi
}

emulator_alive()
{
    [ -n "$emulator_pid" ] || return 1
    kill -0 "$emulator_pid" 2>/dev/null || return 1
    case "$(ps -o stat= -p "$emulator_pid" 2>/dev/null | tr -d ' ')" in
        Z*) return 1 ;;
    esac
    return 0
}

trap 'stop_emulator' EXIT
trap 'exit 130' INT TERM

mkdir "$work_root"
cp -a "$af_root/dir/System" "$system_root"
cp -a "$repo_dir/tools/ed-amiga-probe/." "$probe_root"
chmod -R u+rwX "$system_root" "$work_root"
cp "$repo_dir/tools/amiga-ed-fresh-startup-sequence" "$system_root/S/Startup-Sequence"
cp "$repo_dir/tools/amiga-ed-fresh-user-startup" "$system_root/S/user-startup"
cp "$repo_dir/tools/amiga-ed-fresh-guest-run" "$probe_root/boot-run"
sed \
    -e "s|__MODEL__|$model|g" \
    -e "s|__ROM__|$rom|g" \
    -e "s|__SYSTEM__|$system_root|g" \
    -e "s|__WORK__|$work_root|g" \
    "$repo_dir/tools/amiga-ed-fs-uae.fs-uae.in" >"$config_file"

"$fs_uae" "$config_file" \
    >"$log_file" 2>&1 &
emulator_pid=$!

complete=$probe_root/results/COMPLETE
ticks=0
while [ ! -f "$complete" ] && [ "$ticks" -lt 600 ]; do
    if ! emulator_alive; then
        printf '%s\n' "FS-UAE exited before the probe completed." >&2
        tail -80 "$log_file" >&2 || true
        exit 1
    fi
    sleep 0.1
    ticks=$((ticks + 1))
done

if [ ! -f "$complete" ]; then
    printf '%s\n' "Timed out waiting for ED probe completion: $complete" >&2
    tail -80 "$log_file" >&2 || true
    exit 1
fi

sleep 0.2
stop_emulator
emulator_pid=

printf 'Fresh Amiga ED run complete.\nRun root: %s\nResults: %s\nLog: %s\n' \
    "$run_root" "$probe_root/results" "$log_file"
