Cross compiling
---------------
1: aclocal
2: autoheader
3: automake -a
4: autoconf
5: (AROS) DAY=$(date +%d.%m.%Y) TAG=$(git describe --tags --abbrev=0) && ./configure --host=i386-aros --disable-iconv --disable-largefile --with-tmp-file=no --with-additional-suffixes="lha," CFLAGS="-DEXPAND_WILDCARDS -D__VER__=$TAG -D__DAY__=$DAY"
5: (OS4) DAY=$(date +%d.%m.%Y) TAG=$(git describe --tags --abbrev=0) && ./configure --host=ppc-amigaos --disable-iconv --with-tmp-file=no --with-additional-suffixes="lha," CFLAGS="-D_XOPEN_SOURCE -DUSE_OLD_ANCHORPATH -D__USE_INLINE__ -DEXPAND_WILDCARDS -D__VER__=$TAG -D__DAY__=$DAY"
5: (MorphOS) DAY=$(date +%d.%m.%Y) TAG=$(git describe --tags --abbrev=0) && ./configure --host=ppc-morphos --disable-iconv --with-tmp-file=no --with-additional-suffixes="lha," CFLAGS="-D__IXEMUL_EXEC_MIXING_ALLOWED -DEXPAND_WILDCARDS -D__VER__=$TAG -D__DAY__=$DAY"
6: make
