#!/usr/bin/env bash

sourced=0
[[ ${BASH_SOURCE[0]} != "$0" ]] && sourced=1
if (( ! sourced )); then
    set +e
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)
if [[ -x $script_dir/build/ace-broker ]]; then
    ace_runtime_dir=$script_dir/build
else
    ace_runtime_dir=$script_dir
fi
broker_binary=$ace_runtime_dir/ace-broker
broker_socket=${ACE_BROKER_SOCKET:-${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/ace-broker.sock}}
broker_socket=${broker_socket:-/tmp/ace-broker-$(id -u).sock}
broker_pid_file=${ACE_BROKER_PIDFILE:-${broker_socket}.pid}
experimental_commands=$ace_runtime_dir

add_experimental_commands_to_path()
{
    case ":${PATH-}:" in
        *":$experimental_commands:"*) ;;
        *) PATH="$experimental_commands${PATH:+:$PATH}"; export PATH ;;
    esac
}

start_failed()
{
    printf '%s\n' 'broker start failed'
    if (( sourced )); then
        return 1
    fi
    exit 1
}

# One broker per user. If a broker already holds this socket's lock, leave it
# alone: restarting it would throw away the current directories, assigns and
# variables of every session it is holding, which is what "start" used to do
# unconditionally on its way past. The lock is the broker's own, so this asks
# the authority rather than guessing from process lists.
broker_lock=$broker_socket.lock
if command -v flock >/dev/null 2>&1 && [[ -e $broker_lock ]] &&
   ! flock -n "$broker_lock" true 2>/dev/null; then
    add_experimental_commands_to_path
    printf '%s\n' 'broker already running'
    if (( sourced )); then return 0; else exit 0; fi
fi

if [[ ! -x $broker_binary ]]; then
    start_failed
    (( sourced )) && return 1
fi

umask 077
nohup "$broker_binary" "$broker_socket" \
    >/dev/null 2>&1 </dev/null &
broker_pid=$!

if ! printf '%s\n' "$broker_pid" > "$broker_pid_file" 2>/dev/null; then
    kill -TERM "$broker_pid" 2>/dev/null
    start_failed
    (( sourced )) && return 1
fi

broker_ready=0
for wait_count in {1..100}; do
    if [[ -S $broker_socket ]] && kill -0 "$broker_pid" 2>/dev/null; then
        broker_ready=1
        break
    fi
    sleep 0.02
done

if (( ! broker_ready )); then
    kill -TERM "$broker_pid" 2>/dev/null
    sleep 0.05
    kill -KILL "$broker_pid" 2>/dev/null
    rm -f -- "$broker_pid_file" 2>/dev/null
    start_failed
    (( sourced )) && return 1
fi

add_experimental_commands_to_path
printf '%s\n' 'broker started'
